# The installer writes this file for you. It's described here only for reference.
APP_PASSWORD='password you sign in with'
SECRET_KEY='long random string'
MCP_TOKEN='long random string for connecting Claude'
GEMINI_API_KEY='from https://aistudio.google.com/apikey'
APIFY_API_TOKEN='optional, only for Instagram links'
SITE_ADDRESS='server version only: site address'
PUBLIC_URL='server version only: https:// + site address'
